# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# Required: Get from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Required: JWT signing secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_generated_secret_here

# Optional: token lifetimes (defaults shown)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional: Gemini model to use (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Only needed for production deployment (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=support-chatbot

# "development" uses FAISS locally
# "production" uses Pinecone
ENVIRONMENT=development

# RAG tuning (optional — defaults shown)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_K=4
